{
  "name": "server_rest_e2e-automation",
  "version": "1.0.0",
  "description": "Automação E2E profissional com Cypress",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",

    "cy:open:qa": "cross-env ENV_FILE=.env.qa cypress open",
    "cy:run:qa": "cross-env ENV_FILE=.env.qa cypress run",

    "cy:open:local": "cross-env ENV_FILE=.env.local cypress open",
    "cy:run:local": "cross-env ENV_FILE=.env.local cypress run",

    "cy:allure:qa": "cross-env ENV_FILE=.env.qa cypress run",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",

    "test:allure:qa": "npm run cy:allure:qa && npm run allure:generate && npm run allure:open",
    "test:ci": "npm run cy:run:qa && npm run allure:generate"
  },
  "keywords": [
    "cypress",
    "automation",
    "e2e",
    "qa",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "allure-cypress": "^3.0.0",
    "cross-env": "^7.0.3",
    "cypress": "^15.14.2",
    "dotenv": "^16.6.1"
  }
}